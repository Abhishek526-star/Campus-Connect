# ============================================================================
# Campus Connect — environment variables
# Copy this file to server/.env and fill in real values.
# NEVER commit the actual .env file. All values here are placeholders.
# ============================================================================

# --- App ---
APP_NAME=Campus Connect
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB Atlas recommended) ---
MONGO_URI=mongodb://127.0.0.1:27017/campus_connect

# --- Authentication (use long random strings in production) ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (files: avatars, event images, documents, chat attachments) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (test-mode keys for development) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Google sign-in (Gmail direct login) ---
# 1. Google Cloud Console → APIs & Services → Credentials → Create "OAuth client ID"
#    (type: Web application).
# 2. Authorized JavaScript origins: http://localhost:5173 (dev) and your
#    production origin.
# 3. Paste the Client ID here. The client reads the SAME id from
#    client/.env → VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=same
VITE_GOOGLE_CLIENT_ID= same

# --- Email — Gmail only (no Twilio/Brevo/SendGrid needed) ---
# Just your Gmail address + an App Password (Google Account → Security →
# 2-Step Verification → App passwords). smtp.gmail.com is picked up
# automatically when SMTP_USER is a @gmail.com address.
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Optional overrides (defaults to smtp.gmail.com:587 for Gmail users):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=Campus Connect <yourname@gmail.com>

# --- Email (SMTP — e.g. SendGrid / Brevo / Resend SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Campus Connect <no-reply@campus-connect.app>"
